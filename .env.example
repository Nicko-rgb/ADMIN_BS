# API Configuration
VITE_API_URL=http://localhost:5010/api
VITE_HOST_SERVER=http://localhost

# Authentication
VITE_AUTH_TOKEN_KEY=authToken

# Application Configuration
VITE_APP_NAME=Booking Sport Administrator
VITE_APP_VERSION=2.0.1

# Environment
VITE_NODE_ENV=development

# File Upload Configuration
VITE_MAX_FILE_SIZE=5242880
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# Pagination Configuration
VITE_DEFAULT_PAGE_SIZE=20
VITE_MAX_PAGE_SIZE=100

# Cache Configuration
VITE_CACHE_TIMEOUT=300000